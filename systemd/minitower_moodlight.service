[Unit]
Description=ABS MiniTower moodlight initialization
DefaultDependencies=no
After=local-fs.target systemd-modules-load.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/minitower-moodlight
Restart=always
RestartSec=30
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
